rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'preferredFramework', 'preferredProvider', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'roleTitle', 'bio', 'avatarUrl',
          'preferredFramework', 'preferredProvider', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (request.auth.token.email == null || data.email == request.auth.token.email)
        && (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 400))
        && (!('avatarUrl' in data) || (
          data.avatarUrl is string
          && data.avatarUrl.size() <= 200000
          && (
            data.avatarUrl.matches('^https://.*')
            || data.avatarUrl.matches('^/src/assets/images/.*')
            || data.avatarUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
          )
        ))
        && data.preferredFramework in ['langgraph', 'crewai']
        && data.preferredProvider in ['google', 'groq']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkflowRun(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'topic', 'framework', 'provider', 'status',
          'cycleCount', 'maxCycles', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'topic', 'framework', 'provider', 'status',
          'cycleCount', 'maxCycles', 'researchNotes', 'draftMarkdown', 'humanFeedback',
          'sources', 'steps', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 500
        && data.framework in ['langgraph', 'crewai']
        && data.provider in ['google', 'groq']
        && data.status in ['idle', 'running', 'awaiting_approval', 'completed', 'error']
        && data.cycleCount is int && data.cycleCount >= 0 && data.cycleCount <= 10
        && data.maxCycles is int && data.maxCycles >= 1 && data.maxCycles <= 5
        && (!('researchNotes' in data) || (data.researchNotes is string && data.researchNotes.size() <= 40000))
        && (!('draftMarkdown' in data) || (data.draftMarkdown is string && data.draftMarkdown.size() <= 80000))
        && (!('humanFeedback' in data) || (data.humanFeedback is string && data.humanFeedback.size() <= 4000))
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 30 && (data.sources.size() == 0 || data.sources[0] is map)))
        && (!('steps' in data) || (data.steps is list && data.steps.size() <= 40 && (data.steps.size() == 0 || data.steps[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'roleTitle', 'bio', 'avatarUrl',
          'preferredFramework', 'preferredProvider', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isVerified() && isOwner(userId);
    }

    match /workflows/{workflowId} {
      allow get: if isValidId(workflowId) && isVerified() && existing().ownerId == request.auth.uid;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(workflowId)
        && isVerified()
        && isValidWorkflowRun(incoming())
        && incoming().id == workflowId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(workflowId)
        && isVerified()
        && existing().ownerId == request.auth.uid
        && existing().status != 'completed'
        && isValidWorkflowRun(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            incoming().status in ['idle', 'running', 'awaiting_approval', 'error']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'topic', 'framework', 'provider', 'status',
              'cycleCount', 'maxCycles', 'researchNotes', 'draftMarkdown',
              'humanFeedback', 'sources', 'steps', 'updatedAt'
            ])
          )
          ||
          (
            existing().status == 'awaiting_approval'
            && incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'draftMarkdown', 'humanFeedback', 'steps', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(workflowId) && isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}
